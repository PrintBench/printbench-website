---
import Icon from './Icon.astro'
import Logo from './Logo.astro'

const github = 'https://github.com/PrintBench/printbench'
const docs = 'https://docs.printbench.app'
---

<footer>
  <div class="footer-main container">
    <div class="footer-brand"><Logo gradientId="footer-logo-gradient" /><p>A calmer home for every model,<br />file and finished print.</p></div>
    <div class="footer-links"><div><strong>Product</strong><a href="/#features">Features</a><a href="/#screenshots">Screenshots</a><a href="/#workflow">How it works</a><a href="/roadmap/">Roadmap</a><a href="/#get-started">Get started</a></div><div><strong>Project</strong><a href={github} target="_blank" rel="noreferrer">GitHub</a><a href={`${github}/blob/main/CONTRIBUTING.md`} target="_blank" rel="noreferrer">Contributing</a><a href={`${github}/blob/main/SECURITY.md`} target="_blank" rel="noreferrer">Security</a></div><div><strong>Resources</strong><a href={docs}>Documentation</a><a href={`${docs}/deploy/`}>Deployment</a><a href={`${docs}/releases/#release-notes`}>Release notes</a><a href={`${github}/issues`} target="_blank" rel="noreferrer">Issues</a><a href={`${github}/blob/main/LICENSE`} target="_blank" rel="noreferrer">MIT license</a></div></div>
  </div>
  <div class="footer-bottom container"><p>© 2026 PrintBench. Open source under the MIT License.</p><a href={github} target="_blank" rel="noreferrer"><Icon name="github" size={16} /> PrintBench on GitHub</a></div>
</footer>
